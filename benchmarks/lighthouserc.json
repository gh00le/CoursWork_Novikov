{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/catalog",
        "http://localhost:8080/mpa/",
        "http://localhost:8080/mpa/catalog"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.4 }],
        "categories:seo": ["warn", { "minScore": 0.7 }],
        "categories:accessibility": ["warn", { "minScore": 0.7 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./benchmarks/results/lhci"
    }
  }
}
